# Backend API (.env.example)
# Copy to .env for local development: cp .env.example .env

# Security
SECRET_KEY=change_me_development_only_min_32_chars________________________________
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
ENCRYPTION_MASTER_KEY=

# Database: Dev uses SQLite file aligned with database_postgres SQLITE_DB
DB_URL=sqlite:///./app.db

# Integrations (Mock eKYC)
EKYC_PROVIDER_API_KEY=dev_ekyc_key
EKYC_WEBHOOK_SECRET=dev_ekyc_webhook_secret

# CORS: include frontend preview origin(s)
# CSV list, e.g.: https://appetize.io,http://localhost:3000
CORS_ORIGINS=https://appetize.io

# Logging and metrics
LOG_LEVEL=INFO
ENABLE_METRICS=false

# Notes:
# - Preview Backend Base URL: https://vscode-internal-23122-beta.beta01.cloud.kavia.ai:3001
# - Docs: https://vscode-internal-23122-beta.beta01.cloud.kavia.ai:3001/docs
