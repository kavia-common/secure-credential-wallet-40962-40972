# SECURITY
SECRET_KEY=replace_me_with_a_long_random_value
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
ENCRYPTION_MASTER_KEY=replace_me_with_a_strong_key

# DATABASE
# For local sqlite development:
DB_URL=sqlite:///./app.db
# Example for Postgres:
# DB_URL=postgresql+psycopg://user:password@host:5432/dbname

# INTEGRATIONS (Mock eKYC)
EKYC_PROVIDER_API_KEY=mock_api_key
EKYC_WEBHOOK_SECRET=mock_webhook_secret

# OTHER
CORS_ORIGINS=*
RATE_LIMITS=
LOG_LEVEL=INFO
ENABLE_METRICS=false
