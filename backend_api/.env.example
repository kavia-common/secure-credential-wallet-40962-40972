# Application
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Security
# Minimum 32 chars; used for JWT signing and as fallback for encryption derivation
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Optional separate encryption master key (if empty, SECRET_KEY is used for derivation)
ENCRYPTION_MASTER_KEY=

# Database
# For local dev sqlite path
DB_URL=sqlite:///./app.db
# Example Postgres:
# DB_URL=postgresql+psycopg://postgres:password@localhost:5432/credentials

# eKYC (mock)
EKYC_PROVIDER_API_KEY=demo-ekyc-api-key
EKYC_WEBHOOK_SECRET=demo-webhook-secret

# Metrics toggle (placeholder)
ENABLE_METRICS=false
