# Backend API - Environment Variables (Development Defaults)

# SECURITY
SECRET_KEY=dev_super_secret_key_change_me_at_least_32_chars_long_123456
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
ENCRYPTION_MASTER_KEY=dev_master_key_change_me_at_least_32_chars_long_abcdef

# DATABASE
# For local dev we use a SQLite file. database_postgres/.env contains the canonical path.
# Point this to the same value as database_postgres/SQLITE_DB (relative to backend_api working dir).
DB_URL=sqlite:///./app.db

# INTEGRATIONS (Mock eKYC)
EKYC_PROVIDER_API_KEY=dev-ekyc-api-key
EKYC_WEBHOOK_SECRET=dev-ekyc-webhook-secret

# CORS
# Comma-separated list of allowed origins (no spaces needed). Example for Flutter web dev server or local web clients.
# Use "*" to allow all origins in development only.
CORS_ORIGINS=*

# LOGGING AND METRICS
LOG_LEVEL=INFO
ENABLE_METRICS=false
