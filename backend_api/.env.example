# Backend API - Environment Example

# SECURITY
SECRET_KEY=change_me_please_min_32_chars_long________________________________
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
ENCRYPTION_MASTER_KEY=

# DATABASE
# Default dev uses SQLite file in backend_api folder
DB_URL=sqlite:///./app.db

# INTEGRATIONS (mock)
EKYC_PROVIDER_API_KEY=
EKYC_WEBHOOK_SECRET=

# OTHER
# Comma-separated list of allowed origins.
# For preview, include https://appetize.io
CORS_ORIGINS=*

LOG_LEVEL=INFO
ENABLE_METRICS=false
