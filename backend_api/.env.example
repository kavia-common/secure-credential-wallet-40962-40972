# Backend API Environment (development)
# Copy this file to .env and adjust values for your environment.

# Security
SECRET_KEY=change_me_to_a_long_random_string_at_least_32_chars
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
ENCRYPTION_MASTER_KEY=

# Database (SQLite for development)
# Use a relative file path so Alembic and the app agree.
DB_URL=sqlite:///./app.db

# Integrations (mock eKYC)
EKYC_PROVIDER_API_KEY=dev-ekyc-key
EKYC_WEBHOOK_SECRET=dev-ekyc-webhook-secret

# CORS: CSV of allowed origins
# Include the frontend preview origin (Appetize) at minimum.
CORS_ORIGINS=https://appetize.io

# Logging and metrics
LOG_LEVEL=INFO
ENABLE_METRICS=false
